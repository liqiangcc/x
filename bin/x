function normalizeDate(input) {
  const digits = String(input).replace(/-/g, "");
  if (!/^\d{8}$/.test(digits)) {
    throw new Error(`Invalid date: ${input}`);
  }
  return digits;
}

function isExplicitFalse(value) {
  return ["0", "false", "no", "off"].includes(String(value ?? "").trim().toLowerCase());
}

function parseOptions(argv, defaults = {}) {
  const options = { _: [], ...defaults };
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (!arg.startsWith("--")) {
      options._.push(arg);
      continue;
    }

    const key = arg.slice(2).replace(/-([a-z])/g, (_, char) => char.toUpperCase());
    if (["latest", "commit", "force", "forcePool", "forceUniverse", "forceStrategyCodes", "strategyOnly", "allCodes", "json", "allowPartial", "proxyPreflight", "noProxyPreflight"].includes(key)) {
      options[key] = true;
      continue;
    }

    const nextArg = argv[index + 1];
    if (!nextArg) {
      throw new Error(`Missing value for ${arg}`);
    }
    options[key] = nextArg;
    index += 1;
  }
  return options;
}

async function runNode(scriptPath, args, options = {}) {
  if (options.streamOutput) {
    return runNodeStreaming(scriptPath, args, options);
  }
  return execFileAsync("node", [path.join(ROOT, scriptPath), ...args], {
    cwd: ROOT,
    env: options.env ?? process.env,
    maxBuffer: options.maxBuffer ?? 50 * 1024 * 1024,
  });
}

function runNodeStreaming(scriptPath, args, options = {}) {
  return new Promise((resolve, reject) => {
    const child = spawn(process.execPath, [path.join(ROOT, scriptPath), ...args], {
      cwd: ROOT,
      env: options.env ?? process.env,
      stdio: ["ignore", "pipe", "pipe"],
    });
    let stdout = "";
    let stderr = "";

    child.stdout.on("data", (chunk) => {
      const text = chunk.toString();
      stdout += text;
      if (options.echoStdout !== false) {
        process.stdout.write(text);
      }
    });
    child.stderr.on("data", (chunk) => {
      const text = chunk.toString();
      stderr += text;
      if (options.echoStderr !== false) {
        process.stderr.write(text);
      }
    });
    child.on("error", reject);
    child.on("close", (code) => {
      const result = { stdout, stderr, streamed: true };
      if (code === 0) {
        resolve(result);
        return;
      }
      const error = new Error(`${scriptPath} failed with exit code ${code ?? 1}`);
      error.code = code ?? 1;
      error.stdout = stdout;
      error.stderr = stderr || error.message;
      error.streamed = true;
      reject(error);
    });
  });
}

async function runNodeAllowFailure(scriptPath, args, options = {}) {
  try {
    const result = await runNode(scriptPath, args, options);
    return { ...result, exitCode: 0 };
  } catch (error) {
    return {
      stdout: error.stdout ?? "",
      stderr: error.stderr ?? error.message,
      streamed: Boolean(error.streamed),
      exitCode: typeof error.code === "number" ? error.code : 1,
    };
  }
}

function writeProcessResult(result) {
  if (result?.streamed) {
    return;
  }
  process.stdout.write(result?.stdout ?? "");
  process.stderr.write(result?.stderr ?? "");
}


async function readJson(filePath, fallback = null) {
  try {
    return JSON.parse(await fs.readFile(filePath, "utf8"));
  } catch (error) {
    if (fallback !== null && error.code === "ENOENT") {
      return fallback;
    }
    throw error;
  }
}

async function writeJson(filePath, payload) {
  await fs.mkdir(path.dirname(filePath), { recursive: true });
  await fs.writeFile(filePath, `${JSON.stringify(payload, null, 2)}\n`, "utf8");
}

function utcCompactTime(date = new Date()) {
  const hours = String(date.getUTCHours()).padStart(2, "0");
  const minutes = String(date.getUTCMinutes()).padStart(2, "0");
  const seconds = String(date.getUTCSeconds()).padStart(2, "0");
  return `${hours}${minutes}${seconds}`;
}

function isoNow() {
  return new Date().toISOString().replace(/\.\d{3}Z$/, "Z");
}

function runIdFor(date, period, now = new Date()) {
  return `${date}T${utcCompactTime(now)}Z_${period}`;
}








function probeDuration(result) {
  return Number.isFinite(result?.router_reported_duration_ms)
    ? result.router_reported_duration_ms
    : result?.client_duration_ms;
}

function selectRouterProbeRegions(report) {
  const results = Array.isArray(report?.results) ? report.results : [];
  return results
    .filter((result) => result.engine === "aws-router" && result.ok && result.region)
    .sort((left, right) => {
      const leftDuration = probeDuration(left);
      const rightDuration = probeDuration(right);
      if (Number.isFinite(leftDuration) && Number.isFinite(rightDuration) && leftDuration !== rightDuration) {
        return leftDuration - rightDuration;
      }
      if (Number.isFinite(leftDuration)) {
        return -1;
      }
      if (Number.isFinite(rightDuration)) {
        return 1;
      }
      return String(left.region).localeCompare(String(right.region));
    })
    .map((result) => result.region)
    .filter((region, index, regions) => regions.indexOf(region) === index);
}

function summarizeRouterProbe(report, selectedRegions, error = null) {
  const results = Array.isArray(report?.results) ? report.results : [];
  const routerResults = results.filter((result) => result.engine === "aws-router");
  const failures = routerResults.filter((result) => !result.ok);
  return {
    status: error
      ? "error"
      : selectedRegions.length > 0
        ? "selected"
        : "fallback_auto",
    attempts: report?.attempts ?? null,
    lmt: report?.lmt ?? null,
    secid: report?.secid ?? null,
    total_regions: routerResults.length,
    successes: selectedRegions.length,
    failures: failures.length,
    selected_regions: selectedRegions,
    error: error?.message ?? null,
  };
}

async function resolveRouterRegionForDaily(options) {
  const requestedRegion = String(options.routerRegion ?? "auto").trim() || "auto";
  const probeEnabled = options.engine === "aws-router" &&
    requestedRegion === "auto" &&
    !isExplicitFalse(options.routerProbe);
  if (!probeEnabled) {
    options.routerRegion = requestedRegion;
    return {
      enabled: false,
      requested_region: requestedRegion,
      resolved_region: requestedRegion,
      summary: summarizeRouterProbe(null, []),
    };
  }

  const configFile = options.config ? rootPath(options.config) : path.join(ROOT, "config", "kline.json");
  const config = await readJson(configFile, {});
  const rawLatencyOptions = {
    attempts: options.routerProbeAttempts ?? DEFAULT_ROUTER_PROBE_ATTEMPTS,
    engine: "aws-router",
    lmt: options.routerProbeLmt ?? DEFAULT_ROUTER_PROBE_LMT,
    period: options.period,
    routerMode: "probe",
    secid: options.routerProbeSecid ?? DEFAULT_ROUTER_PROBE_SECID,
    targetRegion: "all",
  };

  try {
    const report = await runLatencyBenchmark(normalizeLatencyOptions(rawLatencyOptions, config));
    const selectedRegions = selectRouterProbeRegions(report);
    options.routerRegion = selectedRegions.length > 0 ? selectedRegions.join(",") : "auto";
    return {
      enabled: true,
      requested_region: requestedRegion,
      resolved_region: options.routerRegion,
      summary: summarizeRouterProbe(report, selectedRegions),
    };
  } catch (error) {
    options.routerRegion = "auto";
    return {
      enabled: true,
      requested_region: requestedRegion,
      resolved_region: "auto",
      summary: summarizeRouterProbe(null, [], error),
    };
  }
}




async function commandAws(argv) {
  const subcommand = argv[0];
  if (subcommand === "probe-router") {
    await commandAwsProbeRouter(argv.slice(1));
    return;
  }
  if (["status", "sync-github-secrets"].includes(subcommand)) {
    await commandAwsMaintenance(argv);
    return;
  }
  if (subcommand === "latency") {
    await commandAwsLatency(argv.slice(1));
    return;
  }
  parseOptions(argv.slice(1));
  throw new Error(`Unknown aws command: ${subcommand ?? ""}`);
}

async function commandKlineFetch(argv) {
  const options = parseOptions(argv, { period: "daily" });
  const input = options._[0];
  if (!input) {
    throw new Error("kline fetch requires <code_or_secid>");
  }

  if (options.policy && options.engine) throw new Error("--policy and --engine cannot be used together.");
  const args = [input, "--period", options.period];
  if (options.policy) args.push("--policy", options.policy);
  else if (options.engine) args.push("--engine", options.engine);
  if (options.awsRegion) {
    args.push("--aws-region", options.awsRegion);
  }
  if (options.routerRegion) {
    args.push("--router-region", options.routerRegion);
  }
  if (options.proxyPoolUrl) {
    args.push("--proxy-pool-url", options.proxyPoolUrl);
  }
  if (options.proxyMaxAttempts) {
    args.push("--proxy-max-attempts", String(options.proxyMaxAttempts));
  }
  if (options.huaweicloudRegion) {
    args.push("--huaweicloud-region", options.huaweicloudRegion);
  }
  if (options.huaweicloudRegionStartIndex) {
    args.push("--huaweicloud-region-start-index", String(options.huaweicloudRegionStartIndex));
  }
  if (options.huaweicloudTargets) {
    args.push("--huaweicloud-targets", options.huaweicloudTargets);
  }
  if (options.lambdaName) {
    args.push("--lambda-name", options.lambdaName);
  }
  if (options.config) {
    args.push("--config", options.config);
  }
  if (options.output) {
    args.push("--output", options.output);
  }

  const { stdout, stderr } = await runNode("fetch/fetch_kline.js", args);
  process.stdout.write(stdout);
  process.stderr.write(stderr);
}

function appendKlineSyncOptions(args, options, { includeOutputDir = true } = {}) {
  if (options.policy) args.push("--policy", options.policy);
  if (options.refreshMode) args.push("--refresh-mode", options.refreshMode);
  if (options.checkpointEvery) args.push("--checkpoint-every", String(options.checkpointEvery));
  if (options.proxyPreflight) args.push("--proxy-preflight");
  if (options.noProxyPreflight) args.push("--no-proxy-preflight");
  if (options.proxyMinAvailable) args.push("--proxy-min-available", String(options.proxyMinAvailable));
  if (options.proxyMinSuccessRate) args.push("--proxy-min-success-rate", String(options.proxyMinSuccessRate));
  if (options.proxyMaxP95Ms) args.push("--proxy-max-p95-ms", String(options.proxyMaxP95Ms));
  if (options.proxyPreflightConcurrency) args.push("--proxy-preflight-concurrency", String(options.proxyPreflightConcurrency));
  if (options.proxyPreflightTimeoutMs) args.push("--proxy-preflight-timeout-ms", String(options.proxyPreflightTimeoutMs));
  if (options.failureQueue) args.push("--failure-queue", options.failureQueue);
  if (options.limit) {
    args.push("--limit", String(options.limit));
  }
  if (options.batchSize) {
    args.push("--batch-size", String(options.batchSize));
  }
  if (options.offset) {
    args.push("--offset", String(options.offset));
  }
  if (includeOutputDir && options.outputDir) {
    args.push("--output-dir", options.outputDir);
  }
  if (options.force) {
    args.push("--force");
  }
  if (options.concurrency) {
    args.push("--concurrency", String(options.concurrency));
  }
  if (options.retryAttempts) {
    args.push("--retry-attempts", String(options.retryAttempts));
  }
  if (options.retryDelayMs) {
    args.push("--retry-delay-ms", String(options.retryDelayMs));
  }
  if (options.retryConcurrency) {
    args.push("--retry-concurrency", String(options.retryConcurrency));
  }
  if (options.awsRegion) {
    args.push("--aws-region", options.awsRegion);
  }
  if (options.routerRegion) {
    args.push("--router-region", options.routerRegion);
  }
  if (options.proxyPoolUrl) {
    args.push("--proxy-pool-url", options.proxyPoolUrl);
  }
  if (options.proxyMaxAttempts) {
    args.push("--proxy-max-attempts", String(options.proxyMaxAttempts));
  }
  if (options.huaweicloudRegion) {
    args.push("--huaweicloud-region", options.huaweicloudRegion);
  }
  if (options.huaweicloudRegionStartIndex) {
    args.push("--huaweicloud-region-start-index", String(options.huaweicloudRegionStartIndex));
  }
  if (options.huaweicloudTargets) {
    args.push("--huaweicloud-targets", options.huaweicloudTargets);
  }
  if (options.lambdaName) {
    args.push("--lambda-name", options.lambdaName);
  }
  if (options.config) {
    args.push("--config", options.config);
  }
  if (options.minSuccessRate) {
    args.push("--min-success-rate", String(options.minSuccessRate));
  }
  if (options.expectedLatestDate) {
    args.push("--expected-latest-date", String(options.expectedLatestDate));
  }
  if (options.freshnessCodes) {
    args.push("--freshness-codes", String(options.freshnessCodes));
  }
}

async function commandPoolPull(argv) {
  const options = parseOptions(argv, { engine: "curl", outputDir: "data/pool" });
  const args = [];

  if (options.date) {
    args.push(normalizeDate(options.date));
  } else if (options._[0]) {
    args.push(normalizeDate(options._[0]));
  } else if (options.latest) {
    args.push("--days", "0");
  }

  if (options.rangeDays) {
    args.push("--range-days", String(options.rangeDays));
  }
  if (options.engine) {
    args.push("--engine", options.engine);
  }
  args.push("--output-dir", options.outputDir);

  const { stdout, stderr } = await runNode("fetch/pull_pool_task.js", args);
  process.stdout.write(stdout);
  process.stderr.write(stderr);
}

async function commandStocks(argv) {
  const subcommand = argv[0];
  if (subcommand !== "fetch") {
    throw new Error(`Unknown stocks command: ${subcommand ?? ""}`);
  }

  const options = parseOptions(argv.slice(1), {
    market: "hs-a",
    outputDir: rel(DEFAULT_UNIVERSE_DIR),
  });
  const args = ["--market", options.market, "--output-dir", options.outputDir];

  if (options.date && options.latest) {
    throw new Error("--date and --latest cannot be used together.");
  } else if (options.date) {
    args.push("--date", normalizeDate(options.date));
  } else {
    args.push("--latest");
  }
  if (options.pageSize) {
    args.push("--page-size", String(options.pageSize));
  }

  const { stdout, stderr } = await runNode("fetch/fetch_market_stocks.js", args);
  process.stdout.write(stdout);
  process.stderr.write(stderr);
}

async function commandCodesBuild(argv) {
  const options = parseOptions(argv);
  const inputPath = options._[0];
  if (!inputPath) {
    throw new Error("codes build requires <pool_dir>");
  }

  const args = [inputPath, "--codes-only"];
  if (options.output) {
    args.push("--output", options.output);
  }
  const { stdout, stderr } = await runNode("utils/parse_pool_json.js", args);
  process.stdout.write(stdout);
  process.stderr.write(stderr);
}

async function commandKlineSync(argv) {
  const options = parseOptions(argv, { period: "daily" });
  const inputPath = options._[0];
  if (!inputPath) {
    throw new Error("kline sync requires <input_dir|codes.json>");
  }

  if (options.policy && options.engine) throw new Error("--policy and --engine cannot be used together.");
  const args = [inputPath, "--period", options.period];
  if (options.engine) args.push("--engine", options.engine);
  appendKlineSyncOptions(args, options);
  const { stdout, stderr } = await runNode("fetch/query_pool_klines.js", args);
  process.stdout.write(stdout);
  process.stderr.write(stderr);
}

async function loadCodesInput(inputPath) {
  const target = rootPath(inputPath);
  const stat = await fs.stat(target);
  if (stat.isDirectory()) return loadCodesJson(target);
  const payload = await readJson(target);
  if (!Array.isArray(payload?.codes)) throw new Error(`Missing codes array: ${rel(target)}`);
  return uniqueCodes(payload.codes);
}

async function commandKlineAggregateYearly(argv) {
  const options = parseOptions(argv, { concurrency: "16" });
  const inputPath = options._[0];
  if (!inputPath) throw new Error("kline aggregate-yearly requires <input_dir|codes.json>.");
  if (!options.date) throw new Error("kline aggregate-yearly requires --date YYYYMMDD.");
  const result = await aggregateYearlyFromDaily({
    codes: await loadCodesInput(inputPath),
    concurrency: parsePositiveIntegerOption(options.concurrency, 16),
    klineRoot: DEFAULT_KLINE_DIR,
    targetDate: options.date,
  });
  process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
  if (result.failed > 0) process.exitCode = 1;
}

function extractRetryCodes(payload) {
  if (Array.isArray(payload?.codes)) {
    return [...new Set(payload.codes.map(String).filter(Boolean))].sort();
  }

  if (payload?.files && typeof payload.files === "object") {
    return Object.entries(payload.files)
      .filter(([, item]) => item?.status === "failed")
      .map(([code, item]) => item?.code ?? code)
      .filter(Boolean)
      .sort();
  }

  if (Array.isArray(payload?.items)) {
    return [...new Set(payload.items
      .map((item) => item?.code ?? item?.target)
      .filter(Boolean)
      .map((value) => String(value).includes(".") ? String(value).split(".")[1] : String(value))
    )].sort();
  }

  return [];
}

function inferKlineOutputDirFromSummary(summaryPath, period) {
  const resolved = path.resolve(summaryPath);
  if (path.basename(resolved) === `summary.${period}.json`) {
    return path.dirname(path.dirname(resolved));
  }
  return "data/kline";
}

async function commandKlineRetry(argv) {
  const options = parseOptions(argv, { engine: "aws" });
  const inputPath = options._[0];
  if (!inputPath) {
    throw new Error("kline retry requires <summary.json|failures.json>");
  }

  const payload = await readJson(path.resolve(inputPath));
  const codes = extractRetryCodes(payload);
  if (codes.length === 0) {
    throw new Error("No failed kline codes found to retry.");
  }

  const itemPeriod = Array.isArray(payload?.items)
    ? payload.items.find((item) => item?.period)?.period
    : null;
  const period = options.period ?? payload.period ?? itemPeriod ?? "daily";
  const outputDir = options.outputDir ?? inferKlineOutputDirFromSummary(inputPath, period);
  const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), "x-kline-retry-"));
  const codesPath = path.join(tempDir, "codes.json");
  await writeJson(codesPath, { codes });

  const args = [
    codesPath,
    "--period",
    period,
    "--engine",
    options.engine,
    "--output-dir",
    outputDir,
  ];
  appendKlineSyncOptions(args, {
    ...options,
    concurrency: options.concurrency ?? 1,
    limit: null,
    outputDir: null,
    period,
    retryAttempts: options.retryAttempts ?? 3,
    retryConcurrency: options.retryConcurrency ?? 1,
  }, { includeOutputDir: false });

  const result = await runNodeAllowFailure("fetch/query_pool_klines.js", args);
  process.stdout.write(result.stdout);
  process.stderr.write(result.stderr);
  await fs.rm(tempDir, { recursive: true, force: true });
  if (result.exitCode !== 0) {
    process.exitCode = result.exitCode;
  }
}

async function commandKlineRetryQueue(argv) {
  const options = parseOptions(argv, { concurrency: "2", policy: "proxy-only" });
  const queueFile = options._[0];
  if (!queueFile) throw new Error("kline retry-queue requires <queue.json>.");
  const absoluteQueue = rootPath(queueFile);
  const dueFile = path.join(path.dirname(absoluteQueue), `${path.basename(absoluteQueue, ".json")}.due.json`);
  const { writeDueCodes } = require("./../src/kline/failure_queue");
  const due = await writeDueCodes(absoluteQueue, dueFile);
  if (due.codes.length === 0) {
    printJson({ status: "no_due_items", queue: absoluteQueue, due: 0 });
    return;
  }
  const args = [dueFile, "--period", due.period, "--policy", options.policy, "--concurrency", String(options.concurrency), "--retry-attempts", "0", "--failure-queue", absoluteQueue];
  if (due.expectedLatestDate) {
    args.push("--expected-latest-date", due.expectedLatestDate.replaceAll("-", ""), "--freshness-codes", dueFile);
  }
  await commandKlineSync(args);
}

async function commandKlineSyncControl(action, argv) {
  const options = parseOptions(argv);
  const { readLock, unlockSync } = require("./../src/kline/sync_lock");
  if (action === "sync-status") {
    const periods = options.period ? [options.period] : ["daily", "yearly"];
    printJson({ locks: await Promise.all(periods.map((period) => readLock(period))) });
    return;
  }
  if (!["daily", "yearly"].includes(options.period)) throw new Error("kline unlock requires --period daily|yearly.");
  printJson(await unlockSync(options.period, { force: Boolean(options.force) }));
}

async function commandKlineValidate(argv) {
  const options = parseOptions(argv);
  const targetPath = options._[0] ?? "data/kline";
  const args = [targetPath];
  if (options.period) {
    args.push("--period", options.period);
  }
  if (options.json) {
    args.push("--json");
  }

  const result = await runNodeAllowFailure("fetch/check_kline_empty.js", args);
  process.stdout.write(result.stdout);
  process.stderr.write(result.stderr);
  if (result.exitCode !== 0) {
    process.exitCode = result.exitCode;
  }
}

async function commandKlineFreshness(argv) {
  const options = parseOptions(argv);
  if (!options.period || !["daily", "yearly"].includes(options.period)) {
    throw new Error("kline freshness requires --period daily|yearly.");
  }
  if (!options.codes) throw new Error("kline freshness requires --codes <codes.json>.");
  const targetRoot = rootPath(options._[0] ?? "data/kline");
  const codesFile = rootPath(options.codes);
  const { inspectFreshness, writeRepairCodes } = require("./../src/kline/freshness");
  const report = await inspectFreshness({
    codesFile,
    expectedLatestDate: options.expectedLatestDate,
    period: options.period,
    targetRoot,
  });
  if (options.repairOutput) {
    const repairOutput = rootPath(options.repairOutput);
    await writeRepairCodes(repairOutput, report);
    report.repair_output = repairOutput;
    const expected = report.expected_latest_date.replaceAll("-", "");
    report.suggested_sync_command = [
      "bin/x kline sync",
      repairOutput,
      "--period", report.period,
      "--policy proxy-only",
      "--expected-latest-date", expected,
      "--freshness-codes", repairOutput,
    ].join(" ");
  } else {
    report.repair_output = null;
    report.suggested_sync_command = null;
  }
  if (options.json) {
    printJson(report);
    return;
  }
  console.log(`Kline freshness: ${report.period}`);
  console.log(`Expected latest date: ${report.expected_latest_date} (${report.expected_date_source})`);
  console.log(`Universe: ${report.universe_count}`);
  console.log(`Fresh: ${report.fresh_count}`);
  console.log(`Stale: ${report.stale_count}`);
  console.log(`Missing: ${report.missing_count}`);
  console.log(`Invalid: ${report.invalid_count}`);
  console.log(`Repair: ${report.repair_count}`);
  console.log(`Fresh rate: ${(report.fresh_rate * 100).toFixed(2)}%`);
  console.log("Latest date distribution:");
  for (const [date, count] of Object.entries(report.latest_date_distribution)) console.log(`${date}\t${count}`);
  if (report.repair_output) console.log(`Repair codes: ${report.repair_output}`);
  if (report.suggested_sync_command) console.log(`Sync: ${report.suggested_sync_command}`);
}

function extractKlineFailures(summary, period) {
  const files = summary?.files && typeof summary.files === "object" ? summary.files : {};
  return Object.entries(files)
    .filter(([, item]) => item?.status === "failed")
    .map(([code, item]) => ({
      target: item.secid ?? code,
      code,
      type: "kline",
      period,
      reason: item.error ?? "unknown error",
      retry_count: 0,
    }));
}

async function buildQuality(runId, validateResult, period) {
  let parsed;
  try {
    parsed = JSON.parse(validateResult.stdout);
  } catch {
    parsed = {
      target_path: rel(path.join(DEFAULT_KLINE_DIR, period)),
      total_files: 0,
      issue_count: 1,
      status: "failed",
      issues: [
        {
          issue: "quality_parse_error",
          error: validateResult.stderr || "failed to parse validator output",
        },
      ],
    };
  }

  return {
    run_id: runId,
    target: parsed.target_path,
    period,
    total_files: parsed.total_files ?? 0,
    issue_count: parsed.issue_count ?? parsed.empty_count ?? 0,
    status: parsed.status ?? ((parsed.issue_count ?? parsed.empty_count ?? 0) > 0 ? "failed" : "ok"),
    issues: parsed.issues ?? [],
  };
}

async function inspectKlineCodes(period, codes) {
  const files = uniqueCodes(codes).flatMap((code) => [
    shardedKlinePath(period, code),
    legacyKlinePath(period, code),
  ]);
  const issues = [];
  let cursor = 0;
  let totalFiles = 0;

  await Promise.all(Array.from({ length: Math.min(16, files.length) }, async () => {
    while (cursor < files.length) {
      const file = files[cursor++];
      try {
        await fs.access(file);
      } catch (error) {
        if (error.code === "ENOENT") continue;
        throw error;
      }
      totalFiles += 1;
      const issue = await inspectFile(file);
      if (issue) issues.push(issue);
    }
  }));

  return {
    target_path: path.join(DEFAULT_KLINE_DIR, period),
    total_files: totalFiles,
    empty_count: issues.length,
    issue_count: issues.length,
    status: issues.length > 0 ? "failed" : "ok",
    issues,
  };
}

async function cleanupInvalidKlineFiles(period, codes = null) {
  let summary;
  try {
    if (Array.isArray(codes)) {
      summary = await inspectKlineCodes(period, codes);
    } else {
      summary = await validateKlinePath({ targetPath: DEFAULT_KLINE_DIR, period });
    }
  } catch (error) {
    if (error?.code !== "ENOENT") {
      throw error;
    }
    return {
      target_path: path.join(DEFAULT_KLINE_DIR, period),
      total_files: 0,
      issue_count: 0,
      status: "ok",
      issues: [],
      removed_codes: [],
    };
  }
  const issues = Array.isArray(summary.issues) ? summary.issues : [];
  const removedCodes = [];

  for (const issue of issues) {
    if (!issue?.file) {
      continue;
    }
    await fs.rm(issue.file, { force: true });
    if (issue.code) {
      removedCodes.push(String(issue.code));
    }
  }

  return {
    ...summary,
    removed_codes: uniqueCodes(removedCodes),
  };
}

function formatExpectedLatestDate(date) {
  const normalized = normalizeDate(date);
  return `${normalized.slice(0, 4)}-${normalized.slice(4, 6)}-${normalized.slice(6, 8)}`;
}

function latestKlineDate(payload) {
  const klines = getKlines(payload);
  if (!Array.isArray(klines.value) || klines.value.length === 0) {
    return null;
  }

  for (let index = klines.value.length - 1; index >= 0; index -= 1) {
    const row = klines.value[index];
    if (typeof row !== "string") {
      continue;
    }
    const date = row.split(",")[0];
    if (/^\d{4}-\d{2}-\d{2}$/.test(date)) {
      return date;
    }
  }

  return null;
}

function shardedKlinePath(period, code) {
  return path.join(DEFAULT_KLINE_DIR, period, code.slice(0, 3), `${code}.json`);
}

function legacyKlinePath(period, code) {
  return path.join(DEFAULT_KLINE_DIR, period, `${code}.json`);
}

async function readFreshnessCodesFromMarketUniverse(inputDir) {
  try {
    const payload = await readJson(path.join(inputDir, "stocks.json"));
    const stocks = Array.isArray(payload?.stocks) ? payload.stocks : [];
    const hasQuoteMetadata = stocks.some((stock) => typeof stock?.quote_available === "boolean");
    if (!hasQuoteMetadata) {
      return null;
    }
    return uniqueCodes(
      stocks
        .filter((stock) => stock?.quote_available === true)
        .map((stock) => stock.code)
    );
  } catch {
    return null;
  }
}

async function buildKlineFreshnessContext({ date, inputDir, marketUniverseDir, options, runDir }) {
  if (!["daily", "yearly"].includes(options.period)) {
    return null;
  }

  const expectedLatestDate = formatExpectedLatestDate(date);
  const marketCodes = options.universe === "market"
    ? await readFreshnessCodesFromMarketUniverse(marketUniverseDir ?? inputDir)
    : null;
  const source = marketCodes ? "market_quote_available" : (options.strategyCodesApplied ? "strategy_codes" : "pool_codes");
  const inputCodes = await loadCodesJson(inputDir);
  const inputCodeSet = new Set(inputCodes);
  const codes = marketCodes
    ? marketCodes.filter((code) => inputCodeSet.has(code))
    : inputCodes;

  if (!codes || codes.length === 0) {
    return {
      codes: new Set(),
      codesPath: null,
      expectedLatestDate,
      source,
    };
  }

  const codesPath = path.join(runDir, "freshness.codes.json");
  await writeJson(codesPath, {
    date,
    expected_latest_date: expectedLatestDate,
    period: options.period,
    source,
    total_codes: codes.length,
    codes,
  });

  return {
    codes: new Set(codes),
    codesPath,
    expectedLatestDate,
    source,
  };
}

async function findStaleKlineCodes({ expectedLatestDate, freshnessCodes, period }) {
  if (!["daily", "yearly"].includes(period) || !expectedLatestDate || !freshnessCodes || freshnessCodes.size === 0) {
    return [];
  }

  const staleCodes = [];
  for (const code of freshnessCodes) {
    let filePath = shardedKlinePath(period, code);
    try {
      await fs.access(filePath);
    } catch {
      filePath = legacyKlinePath(period, code);
    }

    let payload;
    try {
      payload = await readJson(filePath);
    } catch {
      staleCodes.push(code);
      continue;
    }

    const latestDate = latestKlineDate(payload);
    if (!latestDate || latestDate < expectedLatestDate) {
      staleCodes.push(code);
    }
  }

  return uniqueCodes(staleCodes);
}

function parsePositiveIntegerOption(value, fallback) {
  const number = Number(value);
  return Number.isInteger(number) && number > 0 ? number : fallback;
}

function parseNonNegativeIntegerOption(value, fallback) {
  const number = Number(value);
  return Number.isInteger(number) && number >= 0 ? number : fallback;
}

function defaultDailyBatchSize(period) {
  return 300;
}

async function loadCodesJson(inputDir) {
  const payload = await readJson(path.join(inputDir, "codes.json"));
  if (!Array.isArray(payload?.codes)) {
    throw new Error(`Missing codes array: ${rel(path.join(inputDir, "codes.json"))}`);
  }
  return uniqueCodes(payload.codes);
}

function defaultDailyJobId({ date, market, period, universe }) {
  const parts = [date, period, universe];
  if (universe === "market") {
    parts.push(market);
  }
  return parts.join("-");
}

function dailyJobIdForOptions(options, date) {
  let fallbackJobId = defaultDailyJobId({
    date,
    market: options.universe === "market" ? options.market : null,
    period: options.period,
    universe: options.universe,
  });
  if (options.limit) {
    fallbackJobId = `${fallbackJobId}-limit-${options.limit}`;
  }
  if (options.offset) {
    fallbackJobId = `${fallbackJobId}-offset-${options.offset}`;
  }
  return normalizeJobId(options.jobId, fallbackJobId);
}

function progressPathFor(date, period, jobId) {
  return path.join(DEFAULT_JOBS_DIR, date, period, jobId, "progress.json");
}

function parseKlineSummaryPath(stdout, period) {
  const expected = `summary.${period}.json`;
  const line = String(stdout ?? "")
    .split(/\r?\n/)
    .map((item) => item.trim())
    .filter(Boolean)
    .reverse()
    .find((item) => item.endsWith(expected));
  return line ? rootPath(line) : null;
}

async function prepareDailyJobProgress(options, { date, inputDir, preselectFailedCodes = [] }) {
  if ((options.jobMode ?? "single") !== "batch") {
    return null;
  }

  const batchSize = parsePositiveIntegerOption(options.batchSize, defaultDailyBatchSize(options.period));
  const chainDepth = parseNonNegativeIntegerOption(options.chainDepth, 0);
  const jobId = dailyJobIdForOptions(options, date);
  const progressPath = progressPathFor(date, options.period, jobId);
  const existingProgress = await readExistingJson(progressPath);
  let progress;

  if (existingProgress) {
    progress = normalizeProgress(existingProgress);
    progress.batch_size = batchSize;
    progress.chain_depth = chainDepth;
    if (options.maxChainDepth) {
      progress.max_chain_depth = parsePositiveIntegerOption(options.maxChainDepth, progress.max_chain_depth);
    }
    if (preselectFailedCodes.length > 0) {
      progress = markProgressCodesFailed(progress, preselectFailedCodes);
    }
  } else {
    let codes = await loadCodesJson(inputDir);
    const offset = parseNonNegativeIntegerOption(options.offset, 0);
    const limit = options.limit ? parsePositiveIntegerOption(options.limit, null) : null;
    codes = codes.slice(offset);
    if (limit !== null) {
      codes = codes.slice(0, limit);
    }
    progress = initializeProgress({
      batchSize,
      chainDepth,
      codes,
      date,
      jobId,
      market: options.universe === "market" ? options.market : null,
      maxChainDepth: options.maxChainDepth
        ? parsePositiveIntegerOption(options.maxChainDepth, null)
        : calculateMaxChainDepth(codes.length, batchSize),
      period: options.period,
      universe: options.universe,
    });
  }

  const selection = selectProgressBatch(progress);
  progress.last_batch_codes = selection.codes;
  progress.last_batch_source = selection.source;
  progress.updated_at = isoNow();
  await writeJson(progressPath, progress);

  const batchCodesPath = path.join(path.dirname(progressPath), "current.codes.json");
  await writeJson(batchCodesPath, {
    job_id: jobId,
    date,
    period: options.period,
    chain_depth: chainDepth,
    batch_size: progress.batch_size,
    selection_source: selection.source,
    codes: selection.codes,
  });

  return {
    batchCodesPath,
    chainDepth,
    jobId,
    progress,
    progressPath,
    selection,
  };
}

async function commandDaily(argv) {
  const options = parseOptions(argv, {
    engine: "auto",
    cnFastThreshold: String(DEFAULT_CN_FAST_THRESHOLD),
    market: "hs-a",
    period: "daily",
    poolEngine: "curl",
    strategyOnly: true,
    outputDir: "data/pool",
    universe: "market",
    universeDir: rel(DEFAULT_UNIVERSE_DIR),
  });
  const startedAt = isoNow();
  if (options.policy && argv.includes("--engine")) throw new Error("--policy and --engine cannot be used together.");
  const streamOutput = isStageLogEnabled();

  if (!options.date && !options.latest) {
    options.latest = true;
  }
  if (!["market", "pool"].includes(options.universe)) {
    throw new Error(`Invalid universe: ${options.universe}`);
  }
  if (!["batch", "single"].includes(options.jobMode ?? "single")) {
    throw new Error(`Invalid job mode: ${options.jobMode}`);
  }
  if (!options.concurrency) {
    options.concurrency = "4";
  }
  const routerProbe = await withStage("router_probe", {
    attempts: options.routerProbeAttempts ?? DEFAULT_ROUTER_PROBE_ATTEMPTS,
    engine: options.engine,
    policy: options.policy ?? null,
    lmt: options.routerProbeLmt ?? DEFAULT_ROUTER_PROBE_LMT,
    period: options.period,
    router_probe: options.routerProbe ?? "true",
    router_region: options.routerRegion ?? "auto",
    secid: options.routerProbeSecid ?? DEFAULT_ROUTER_PROBE_SECID,
  }, () => resolveRouterRegionForDaily(options));
  stageLog("end", "router_probe_result", {
    enabled: routerProbe.enabled,
    failures: routerProbe.summary.failures,
    lmt: routerProbe.summary.lmt,
    requested_region: routerProbe.requested_region,
    resolved_region: routerProbe.resolved_region,
    secid: routerProbe.summary.secid,
    status: routerProbe.summary.status,
    successes: routerProbe.summary.successes,
  });
  stageLog("start", "daily_start", {
    date: options.date ?? null,
    latest: Boolean(options.latest),
    period: options.period,
    engine: options.engine,
    router_region: options.routerRegion ?? "auto",
    router_probe: options.routerProbe ?? "true",
    universe: options.universe,
    job_mode: options.jobMode ?? "single",
    batch_size: options.batchSize ?? null,
    concurrency: options.concurrency,
    force: Boolean(options.force),
  });

  let date = options.date ? normalizeDate(options.date) : null;
  let poolResult;

  poolResult = await withStage("pool_snapshot", {
    date,
    latest: Boolean(options.latest),
    output_dir: options.outputDir,
    force_pool: Boolean(options.forcePool),
  }, async () => {
    if (!date && options.latest && !options.forcePool) {
      const cachedSummary = await readJson(path.join(ROOT, options.outputDir, "summary.json"), {});
      const cachedDate = cachedSummary?.requested_date ? normalizeDate(cachedSummary.requested_date) : null;
      if (cachedDate === formatMarketDate() && await hasCompletePoolSnapshot(cachedDate, options.outputDir)) {
        date = cachedDate;
        return {
          stdout: `Using today's pool snapshot: ${rel(path.join(ROOT, options.outputDir, cachedDate))}\n`,
          stderr: "",
          exitCode: 0,
        };
      }
    }
    if (date && !options.forcePool && (await hasCompletePoolSnapshot(date, options.outputDir))) {
      return {
        stdout: `Using existing pool snapshot: ${rel(path.join(ROOT, options.outputDir, date))}\n`,
        stderr: "",
        exitCode: 0,
      };
    }
    const poolArgs = ["--output-dir", options.outputDir, "--engine", options.poolEngine];
    if (date) {
      poolArgs.unshift(date);
    } else {
      poolArgs.unshift("--days", "0");
    }

    return runNodeAllowFailure("fetch/pull_pool_task.js", poolArgs, { streamOutput });
  });
  writeProcessResult(poolResult);
  stageLog("end", "pool_snapshot_result", {
    exit_code: poolResult.exitCode,
    stdout_bytes: poolResult.stdout.length,
    stderr_bytes: poolResult.stderr.length,
  });

  const poolSummaryPath = path.join(ROOT, options.outputDir, "summary.json");
  const poolSummary = await readJson(poolSummaryPath, {});
  if (!date && poolResult.exitCode !== 0) {
    throw new Error("Failed to resolve latest pool date.");
  }
  date = normalizeDate(date ?? poolSummary.requested_date);
  if (!(await hasCompletePoolSnapshot(date, options.outputDir))) {
    throw new Error(`Pool snapshot is incomplete or has mismatched qdate: ${rel(path.join(ROOT, options.outputDir, date))}`);
  }
  stageLog("end", "resolve_date", { date, pool_summary: rel(poolSummaryPath) });
  const poolDir = path.join(ROOT, options.outputDir, date);
  const runId = options.runId ?? runIdFor(date, options.period);
  const runDir = path.join(DEFAULT_RUNS_DIR, runId);
  const jobMode = options.jobMode ?? "single";
  const plannedJobId = jobMode === "batch" ? dailyJobIdForOptions(options, date) : null;

  let codesResult;
  let inputDir = poolDir;
  let universeSummary = null;
  codesResult = await withStage("market_universe", {
    date,
    universe: options.universe,
    market: options.market,
    force_universe: Boolean(options.forceUniverse),
    job_id: plannedJobId,
  }, async () => {
    if (options.universe === "pool") {
      return runNodeAllowFailure("utils/parse_pool_json.js", [rel(poolDir), "--codes-only"], { streamOutput });
    }

    const sharedUniverseDir = rootPath(options.universeDir);
    const privateUniverseRoot = marketUniverseRootForRun({
      date,
      jobId: plannedJobId,
      jobMode,
      period: options.period,
      runId,
    }, {
      jobsDir: DEFAULT_JOBS_DIR,
      runsDir: DEFAULT_RUNS_DIR,
    });
    inputDir = path.join(privateUniverseRoot, date);
    const completePrivateUniverse = await hasCompleteMarketUniverse(date, privateUniverseRoot, options.market);
    const completeSharedUniverse = await hasCompleteMarketUniverse(date, sharedUniverseDir, options.market);
    stageLog("progress", "market_universe_cache", {
      input_dir: rel(inputDir),
      private_complete: completePrivateUniverse,
      shared_complete: completeSharedUniverse,
    });

    if (shouldReuseMarketUniverse({ complete: completePrivateUniverse, forceUniverse: options.forceUniverse })) {
      return {
        stdout: `Using existing private market universe: ${rel(inputDir)}\n`,
        stderr: "",
        exitCode: 0,
      };
    }
    if (shouldReuseMarketUniverse({ complete: completeSharedUniverse, forceUniverse: options.forceUniverse })) {
      await copyMarketUniverseSnapshot(date, sharedUniverseDir, privateUniverseRoot);
      return {
        stdout: `Copied market universe: ${rel(path.join(sharedUniverseDir, date))} -> ${rel(inputDir)}\n`,
        stderr: "",
        exitCode: 0,
      };
    } else {
      const result = await runNodeAllowFailure("fetch/fetch_market_stocks.js", [
        "--date",
        date,
        "--market",
        options.market,
        "--output-dir",
        rel(sharedUniverseDir),
      ], { streamOutput });
      if (result.exitCode === 0 && await hasCompleteMarketUniverse(date, sharedUniverseDir, options.market)) {
        await copyMarketUniverseSnapshot(date, sharedUniverseDir, privateUniverseRoot);
      }
      return result;
    }
  });
  universeSummary = options.universe === "market"
    ? await readJson(path.join(inputDir, "summary.json"), null).catch(() => null)
    : null;
  writeProcessResult(codesResult);
  stageLog("end", "market_universe_result", {
    exit_code: codesResult.exitCode,
    input_dir: rel(inputDir),
    total_codes: universeSummary?.total_codes ?? null,
  });

  const universeInputDir = inputDir;
  let strategyUniverse = null;
  if (options.strategyOnly && !options.allCodes) {
    const sourceCodes = await loadCodesJson(inputDir);
    const strategySyncId = options.strategyId ?? STRATEGY_ID;
    if (!/^[A-Za-z0-9._-]+$/.test(strategySyncId)) throw new Error("--strategy-id contains unsupported characters.");
    const strategyDir = path.join(ROOT, "data", "strategy-universe", date.slice(0, 4), strategySyncId);
    const strategyCodesPath = path.join(strategyDir, "codes.json");
    const strategyDefinition = options.strategyDefinition
      ? await readJson(rootPath(options.strategyDefinition), null)
      : { downTransitions: parsePositiveIntegerOption(options.strategyDownTransitions, 3), type: "year_decline_close_breakout" };
    if (!strategyDefinition) throw new Error("Unable to read --strategy-definition.");
    strategyUniverse = await withStage("strategy_universe", {
      date,
      source_codes: sourceCodes.length,
      strategy_id: STRATEGY_ID,
    }, () => buildStrategyUniverse({
      asOfDate: date,
      codes: sourceCodes,
      concurrency: parsePositiveIntegerOption(options.concurrency, 32),
      force: Boolean(options.forceStrategyCodes),
      klineRoot: DEFAULT_KLINE_DIR,
      marketBoards: options.strategyBoards ? String(options.strategyBoards).split(",").filter(Boolean) : null,
      outputFile: strategyCodesPath,
      strategyDefinition,
      strategyId: strategySyncId,
    }));
    inputDir = strategyDir;
    options.strategyCodesApplied = true;
    stageLog("end", "strategy_universe_result", {
      eligible_codes: strategyUniverse.total_codes,
      input_dir: rel(inputDir),
      missing_yearly_codes: strategyUniverse.missing_yearly_count,
      reused: strategyUniverse.reused,
      source_codes: strategyUniverse.source_code_count,
    });
    if (!options.policy) {
      const engineSelection = await withStage("strategy_sync_engine_probe", {
        requested_engine: options.engine,
        selected_codes: strategyUniverse.total_codes,
        threshold: options.cnFastThreshold,
      }, () => selectStrategySyncEngine({
        codes: strategyUniverse.codes,
        period: options.period,
        requestedEngine: options.engine,
        selectedCodeCount: strategyUniverse.total_codes,
        threshold: options.cnFastThreshold,
      }));
      options.engine = engineSelection.engine;
      if (engineSelection.policy) {
        options.policy = engineSelection.policy;
        options.proxyPreflight = true;
        options.proxyMinAvailable ??= Math.min(3, parsePositiveIntegerOption(options.concurrency, 4));
        options.proxyMinSuccessRate ??= 0.02;
        options.proxyMaxP95Ms ??= 2000;
        options.proxyPreflightConcurrency ??= 16;
        options.proxyPreflightTimeoutMs ??= 2000;
        options.proxyMaxAttempts ??= 2;
      }
      stageLog("end", "strategy_sync_engine_selection", {
        engine: engineSelection.engine,
        local_probe: engineSelection.localProbe,
        policy: engineSelection.policy,
        reason: engineSelection.reason,
        requested_engine: engineSelection.requestedEngine,
        selected_codes: engineSelection.selectedCodeCount,
        threshold: engineSelection.threshold,
      });
    }
  }

  const freshnessContext = await withStage("freshness_context", {
    date,
    period: options.period,
    input_dir: rel(inputDir),
  }, () => buildKlineFreshnessContext({
    date,
    inputDir,
    marketUniverseDir: options.universe === "market" ? universeInputDir : null,
    options,
    runDir,
  }));
  if (freshnessContext?.expectedLatestDate && freshnessContext.codesPath) {
    options.expectedLatestDate = freshnessContext.expectedLatestDate;
    options.freshnessCodes = rel(freshnessContext.codesPath);
  }
  stageLog("end", "freshness_context_result", {
    expected_latest_date: freshnessContext?.expectedLatestDate ?? null,
    freshness_codes: freshnessContext?.codes?.size ?? null,
    freshness_source: freshnessContext?.source ?? null,
    freshness_codes_path: freshnessContext?.codesPath ? rel(freshnessContext.codesPath) : null,
  });
  const staleCodes = await withStage("stale_scan", {
    expected_latest_date: freshnessContext?.expectedLatestDate ?? null,
    period: options.period,
  }, () => findStaleKlineCodes({
    expectedLatestDate: freshnessContext?.expectedLatestDate ?? null,
    freshnessCodes: freshnessContext?.codes ?? null,
    period: options.period,
  }));
  stageLog("end", "stale_scan_result", { stale_codes: staleCodes.length });
  const staleCodesPath = path.join(runDir, "stale-codes.json");
  await writeJson(staleCodesPath, {
    date,
    expected_latest_date: freshnessContext?.expectedLatestDate ?? null,
    period: options.period,
    total_codes: staleCodes.length,
    codes: staleCodes,
  });
  const jobContext = await withStage("prepare_job_progress", {
    date,
    period: options.period,
    job_mode: options.jobMode ?? "single",
    job_id: plannedJobId,
    stale_codes: staleCodes.length,
  }, () => prepareDailyJobProgress(options, {
    date,
    inputDir,
    preselectFailedCodes: staleCodes,
  }));
  let progress = jobContext?.progress ?? null;
  stageLog("end", "prepare_job_progress_result", {
    job_id: jobContext?.jobId ?? null,
    chain_depth: jobContext?.chainDepth ?? null,
    max_chain_depth: progress?.max_chain_depth ?? null,
    batch_size: progress?.batch_size ?? null,
    batch_codes: jobContext?.selection.codes.length ?? null,
    batch_source: jobContext?.selection.source ?? null,
    progress_counts: progress?.counts ?? null,
    progress_file: jobContext ? rel(jobContext.progressPath) : null,
  });
  const cleanupCodes = jobContext?.selection.codes
    ?? (freshnessContext ? staleCodes : (strategyUniverse?.codes ?? await loadCodesJson(inputDir)));
  const cleanupSummary = await withStage("cleanup_invalid_kline", {
    period: options.period,
    scoped_codes: cleanupCodes.length,
  }, () => cleanupInvalidKlineFiles(options.period, cleanupCodes));
  if (cleanupSummary.removed_codes.length > 0) {
    console.error(
      `Removed ${cleanupSummary.removed_codes.length} invalid ${options.period} kline file(s) before sync.`
    );
    if (jobContext) {
      progress = markProgressCodesFailed(progress, cleanupSummary.removed_codes);
      await writeJson(jobContext.progressPath, progress);
    }
  }
  stageLog("end", "cleanup_invalid_kline_result", {
    checked_files: cleanupSummary.total_files,
    removed_codes: cleanupSummary.removed_codes.length,
  });
  const klineInputPath = jobContext
    ? jobContext.batchCodesPath
    : (freshnessContext ? staleCodesPath : inputDir);
  const klineOptions = jobContext
    ? { ...options, batchSize: null, limit: null, offset: null }
    : options;
  const klineArgs = [rel(klineInputPath), "--period", options.period];
  if (!options.policy) klineArgs.push("--engine", options.engine);
  appendKlineSyncOptions(klineArgs, klineOptions, { includeOutputDir: false });
  const klineResult = await withStage("kline_sync", {
    period: options.period,
    engine: options.engine,
    policy: options.policy ?? null,
    kline_input: rel(klineInputPath),
    expected_latest_date: options.expectedLatestDate ?? null,
    freshness_codes: options.freshnessCodes ?? null,
    concurrency: options.concurrency,
    retry_attempts: options.retryAttempts ?? null,
    router_region: options.routerRegion ?? null,
  }, () => runNodeAllowFailure("fetch/query_pool_klines.js", klineArgs, { streamOutput }));
  writeProcessResult(klineResult);
  stageLog("end", "kline_sync_result", {
    exit_code: klineResult.exitCode,
    stdout_bytes: klineResult.stdout.length,
    stderr_bytes: klineResult.stderr.length,
  });

  const defaultSummaryPath = path.join(DEFAULT_KLINE_DIR, options.period, `summary.${options.period}.json`);
  const emittedSummaryPath = parseKlineSummaryPath(klineResult.stdout, options.period);
  const summaryPath = emittedSummaryPath ?? defaultSummaryPath;
  const emptyKlineSummary = {
    period: options.period,
    total_codes: 0,
    success: 0,
    migrated_existing: 0,
    skipped_existing: 0,
    failed: 0,
    files: {},
  };
  const klineSummary = emittedSummaryPath
    ? await readJson(summaryPath, emptyKlineSummary)
    : emptyKlineSummary;
  const updatedCodes = uniqueCodes(Object.entries(klineSummary.files ?? {})
    .filter(([, file]) => file?.status === "success")
    .map(([code]) => code));
  const updatedCodesPath = path.join(runDir, "updated-codes.json");
  await writeJson(updatedCodesPath, {
    date,
    period: options.period,
    total_codes: updatedCodes.length,
    codes: updatedCodes,
  });
  stageLog("end", "kline_summary_read", {
    summary_path: rel(summaryPath),
    emitted_summary: Boolean(emittedSummaryPath),
    total_codes: klineSummary.total_codes ?? null,
    success: klineSummary.success ?? null,
    failed: klineSummary.failed ?? null,
    skipped_existing: klineSummary.skipped_existing ?? null,
    status: klineSummary.status ?? null,
  });

  let yearlyAggregation = null;
  if (options.period === "daily") {
    yearlyAggregation = await withStage("aggregate_yearly", {
      date,
      updated_codes: updatedCodes.length,
    }, async () => aggregateYearlyFromDaily({
      codes: updatedCodes,
      concurrency: parsePositiveIntegerOption(options.concurrency, 16),
      klineRoot: DEFAULT_KLINE_DIR,
      targetDate: date,
    }));
    await writeJson(path.join(runDir, "yearly-aggregation.json"), yearlyAggregation);
    stageLog("end", "aggregate_yearly_result", {
      failed: yearlyAggregation.failed,
      skipped: yearlyAggregation.skipped,
      total: yearlyAggregation.total,
      updated: yearlyAggregation.updated,
    });
  }

  if (jobContext) {
    progress = await withStage("apply_progress", {
      job_id: jobContext.jobId,
      chain_depth: jobContext.chainDepth,
      progress_file: rel(jobContext.progressPath),
    }, async () => applyProgressResults(progress, klineSummary, {
      chainDepth: jobContext.chainDepth,
    }));
    await writeJson(jobContext.progressPath, progress);
    stageLog("end", "apply_progress_result", {
      job_id: jobContext.jobId,
      status: progress.status,
      counts: progress.counts,
    });
  }

  const validateResult = await withStage("validate_kline", {
    period: options.period,
    scoped_codes: updatedCodes.length,
  }, async () => {
    const summary = await inspectKlineCodes(options.period, updatedCodes);
    return {
      exitCode: summary.issue_count > 0 ? 1 : 0,
      stderr: "",
      stdout: JSON.stringify(summary),
    };
  });
  const quality = await buildQuality(runId, validateResult, options.period);
  stageLog("end", "validate_kline_result", {
    exit_code: validateResult.exitCode,
    quality_status: quality.status,
    issue_count: quality.issue_count ?? null,
  });
  const failures = {
    run_id: runId,
    failed: 0,
    items: extractKlineFailures(klineSummary, options.period),
  };
  failures.failed = failures.items.length;

  const klineFailed = Number(klineSummary.failed ?? 0);
  const unexpectedKlineFailure = klineResult.exitCode !== 0 && klineFailed === 0;
  const klineFailureReasons = Array.isArray(klineSummary.failure_reasons) ? klineSummary.failure_reasons : [];
  const hardKlineReasons = jobContext
    ? ["aws_success_zero"]
    : ["success_rate_below_minimum", "aws_success_zero"];
  const hardKlineFailure = klineFailureReasons.some((reason) =>
    hardKlineReasons.includes(reason)
  );
  const progressBlocked = progress?.status === "blocked";
  const hardFailed =
    poolResult.exitCode !== 0 ||
    codesResult.exitCode !== 0 ||
    quality.status === "failed" ||
    unexpectedKlineFailure ||
    hardKlineFailure ||
    (yearlyAggregation?.failed ?? 0) > 0 ||
    progressBlocked;
  const failed =
    klineFailed +
    (poolResult.exitCode === 0 ? 0 : 1) +
    (codesResult.exitCode === 0 ? 0 : 1);
  const success = Number(klineSummary.success ?? 0) + Number(klineSummary.migrated_existing ?? 0);
  const skipped = Number(klineSummary.skipped_existing ?? 0);
  const total = Number(klineSummary.total_codes ?? success + skipped + Number(klineSummary.failed ?? 0));
  const status =
    hardFailed || failed > 0 || quality.status === "failed"
      ? "completed_with_failures"
      : "completed";
  const shouldDispatchNext =
    Boolean(jobContext) &&
    progress?.status === "running" &&
    !hardFailed &&
    jobContext.chainDepth < progress.max_chain_depth;

  const run = {
    run_id: runId,
    type: "daily",
    date,
    period: options.period,
    engine: options.engine,
    aws_region: options.awsRegion ?? null,
    router_region_requested: routerProbe.requested_region,
    router_region_resolved: routerProbe.resolved_region,
    router_probe_requested: options.routerProbe ?? "true",
    router_probe_attempts: options.routerProbeAttempts ?? DEFAULT_ROUTER_PROBE_ATTEMPTS,
    router_probe_lmt: options.routerProbeLmt ?? DEFAULT_ROUTER_PROBE_LMT,
    router_probe_secid: options.routerProbeSecid ?? DEFAULT_ROUTER_PROBE_SECID,
    router_probe_enabled: routerProbe.enabled,
    router_probe_summary: routerProbe.summary,
    huaweicloud_region: options.huaweicloudRegion ?? null,
    lambda_name: options.lambdaName ?? null,
    config: options.config ?? null,
    concurrency: options.concurrency ?? null,
    retry_attempts: options.retryAttempts ?? null,
    retry_concurrency: options.retryConcurrency ?? null,
    min_success_rate: options.minSuccessRate ?? null,
    force: Boolean(options.force),
    universe: options.universe,
    market: options.universe === "market" ? options.market : null,
    universe_total_codes: universeSummary?.total_codes ?? null,
    strategy_only: Boolean(strategyUniverse),
    strategy_id: strategyUniverse?.strategy_id ?? null,
    strategy_source_codes: strategyUniverse?.source_code_count ?? null,
    strategy_codes: strategyUniverse?.total_codes ?? null,
    strategy_missing_yearly_codes: strategyUniverse?.missing_yearly_count ?? null,
    yearly_aggregation_total: yearlyAggregation?.total ?? null,
    yearly_aggregation_updated: yearlyAggregation?.updated ?? null,
    yearly_aggregation_skipped: yearlyAggregation?.skipped ?? null,
    yearly_aggregation_failed: yearlyAggregation?.failed ?? null,
    updated_codes: updatedCodes.length,
    input: rel(path.join(inputDir, "codes.json")),
    kline_input: rel(klineInputPath),
    status,
    total,
    success,
    skipped,
    failed,
    batch_size: jobContext ? progress.batch_size : (klineSummary.batch_size ?? null),
    selection_mode: klineSummary.selection_mode ?? null,
    job_mode: jobContext ? "batch" : (options.jobMode ?? "single"),
    job_id: jobContext?.jobId ?? null,
    job_status: progress?.status ?? null,
    chain_depth: progress?.chain_depth ?? null,
    max_chain_depth: progress?.max_chain_depth ?? null,
    should_dispatch_next: shouldDispatchNext,
    progress_counts: progress?.counts ?? null,
    progress_file: jobContext ? rel(jobContext.progressPath) : null,
    progress_batch_source: jobContext?.selection.source ?? null,
    progress_batch_codes: jobContext?.selection.codes.length ?? null,
    initial_failed: klineSummary.initial_failed ?? 0,
    retried: klineSummary.retried ?? 0,
    retry_success: klineSummary.retry_success ?? 0,
    retry_failed: klineSummary.retry_failed ?? 0,
    kline_success_rate: klineSummary.success_rate ?? null,
    kline_engine_counts: klineSummary.engine_counts ?? {},
    kline_failure_reason_counts: klineSummary.failure_reason_counts ?? {},
    kline_region_counts: klineSummary.region_counts ?? {},
    kline_failure_reasons: klineFailureReasons,
    expected_latest_date: freshnessContext?.expectedLatestDate ?? null,
    freshness_codes: freshnessContext?.codes.size ?? null,
    freshness_source: freshnessContext?.source ?? null,
    stale_completed: staleCodes.length,
    started_at: startedAt,
    finished_at: isoNow(),
    artifacts: {
      pool_dir: rel(poolDir),
      universe_dir: options.universe === "market" ? rel(universeInputDir) : null,
      strategy_codes: strategyUniverse ? rel(path.join(inputDir, "codes.json")) : null,
      yearly_aggregation: yearlyAggregation ? rel(path.join(runDir, "yearly-aggregation.json")) : null,
      updated_codes: rel(updatedCodesPath),
      stale_codes: rel(staleCodesPath),
      job_progress: jobContext ? rel(jobContext.progressPath) : null,
      job_batch_codes: jobContext ? rel(jobContext.batchCodesPath) : null,
      kline_dir: rel(path.join(DEFAULT_KLINE_DIR, options.period)),
      kline_summary: rel(summaryPath),
      freshness_codes: freshnessContext?.codesPath ? rel(freshnessContext.codesPath) : null,
      run: rel(path.join(runDir, "run.json")),
      failures: rel(path.join(runDir, "failures.json")),
      quality: rel(path.join(runDir, "quality.json")),
    },
    commands: {
      pool_exit_code: poolResult.exitCode,
      codes_exit_code: codesResult.exitCode,
      universe_exit_code: options.universe === "market" ? codesResult.exitCode : null,
      kline_exit_code: klineResult.exitCode,
      quality_exit_code: validateResult.exitCode,
    },
  };

  await withStage("write_run_artifacts", {
    run_id: runId,
    run_dir: rel(runDir),
  }, async () => {
    await writeJson(path.join(runDir, "failures.json"), failures);
    await writeJson(path.join(runDir, "quality.json"), quality);
    await writeJson(path.join(runDir, "run.json"), run);
  });
  console.log(rel(path.join(runDir, "run.json")));
  printDailyRunSummary(run, quality, failures);

  if (options.commit) {
    await withStage("commit_data", {
      run_id: runId,
      status: run.status,
      job_status: run.job_status,
      should_dispatch_next: run.should_dispatch_next,
    }, () => commitData(runId));
  }

  stageLog("end", "daily_end", {
    run_id: runId,
    date,
    period: options.period,
    status: run.status,
    job_status: run.job_status,
    should_dispatch_next: run.should_dispatch_next,
  });
  if (run.status !== "completed" && options.allowPartial && !hardFailed) {
    console.error("Daily run completed with partial kline failures; --allow-partial enabled.");
  } else if (run.status !== "completed") {
    process.exitCode = 1;
  }
}

async function hasCompletePoolSnapshot(date, outputDir) {
  const poolDir = path.join(ROOT, outputDir, date);
  for (const pool of ["dt", "qs", "zb", "zt"]) {
    try {
      const payload = JSON.parse(await fs.readFile(path.join(poolDir, `${pool}.json`), "utf8"));
      if (String(payload?.data?.qdate ?? "") !== date) {
        return false;
      }
      if (!Array.isArray(payload?.data?.pool)) {
        return false;
      }
    } catch {
      return false;
    }
  }
  return true;
}
async function readExistingJson(filePath) {
  try {
    return JSON.parse(await fs.readFile(filePath, "utf8"));
  } catch {
    return null;
  }
}

async function commandReport(argv) {
  const subcommand = argv[0];
  if (subcommand !== "daily") {
    throw new Error(`Unknown report command: ${subcommand ?? ""}`);
  }

  const options = parseOptions(argv.slice(1));
  if (!options.date) {
    throw new Error("report daily requires --date <YYYYMMDD>");
  }

  const date = normalizeDate(options.date);
  const report = await generateDailyReport({
    date,
    klineDir: DEFAULT_KLINE_DIR,
    outputDir: path.join(ROOT, "reports"),
    poolDir: DEFAULT_POOL_DIR,
  });
  console.log(rel(report.reportDir));
}

function printJson(payload) {
  process.stdout.write(`${JSON.stringify(payload, null, 2)}\n`);
}

async function commandProxy(argv) {
  const subcommand = argv[0];
  if (subcommand === "pool") {
    await commandProxyPool(argv.slice(1));
    return;
  }
  const options = parseOptions(argv.slice(1));
  const { checkEastmoneyAccess, listProxies, rotateProxy } = require("./../src/proxy/clash");
  const common = {
    configFile: options.config,
    groupName: options.group,
  };

  if (subcommand === "list") {
    printJson(await listProxies(common));
    return;
  }

  if (subcommand === "rotate") {
    printJson(await rotateProxy({ ...common, proxyName: options.proxy ?? null }));
    return;
  }

  if (subcommand === "check") {
    printJson(await checkEastmoneyAccess());
    return;
  }

  throw new Error(`Unknown proxy command: ${subcommand ?? ""}`);
}

function parseDurationMs(value) {
  const match = String(value ?? "").trim().match(/^(\d+)(s|m|h)$/i);
  if (!match || Number(match[1]) < 1) {
    throw new Error(`Invalid duration: ${value}. Use values such as 30s, 30m, or 1h.`);
  }
  const multiplier = { s: 1000, m: 60_000, h: 3_600_000 }[match[2].toLowerCase()];
  return Number(match[1]) * multiplier;
}

function parsePositiveOption(value, name, fallback) {
  if (value === undefined || value === null || value === "") {
    return fallback;
  }
  const number = Number(value);
  if (!Number.isInteger(number) || number < 1) {
    throw new Error(`${name} must be a positive integer.`);
  }
  return number;
}

async function proxyCompose(args) {
  const composeDir = path.join(ROOT, "ops/proxy-pool");
  const envFile = path.join(composeDir, ".env");
  try {
    await fs.access(envFile);
  } catch {
    throw new Error("Missing ops/proxy-pool/.env; copy .env.example and set PROXY_POOL_API_KEY first.");
  }
  const result = await execFileAsync("docker", [
    "compose",
    "--env-file",
    envFile,
    "-f",
    path.join(composeDir, "compose.yml"),
    ...args,
  ], { cwd: ROOT, maxBuffer: 20 * 1024 * 1024 });
  process.stdout.write(result.stdout ?? "");
  process.stderr.write(result.stderr ?? "");
}

async function writeProxyBenchmarkReport(report, kind) {
  const runId = new Date().toISOString().replaceAll(/[-:]/g, "").replace(/\.\d{3}Z$/, "Z");
  const outputDir = path.join(DEFAULT_RUNS_DIR, "proxy-benchmark", `${runId}_${kind}`);
  const outputFile = path.join(outputDir, "report.json");
  await fs.mkdir(outputDir, { recursive: true });
  await fs.writeFile(outputFile, `${JSON.stringify(report, null, 2)}\n`, "utf8");
  return rel(outputFile);
}

async function writeProxyVerificationReport(report, requestedOutput) {
  const runId = new Date().toISOString().replaceAll(/[-:]/g, "").replace(/\.\d{3}Z$/, "Z");
  const outputDir = requestedOutput
    ? path.dirname(rootPath(requestedOutput))
    : path.join(DEFAULT_RUNS_DIR, "proxy-verify", runId);
  const outputFile = requestedOutput ? rootPath(requestedOutput) : path.join(outputDir, "report.json");
  const availableFile = path.join(outputDir, "available.txt");
  await fs.mkdir(outputDir, { recursive: true });
  await fs.writeFile(outputFile, `${JSON.stringify(report, null, 2)}\n`, "utf8");
  await fs.writeFile(availableFile, report.available.map((item) => item.proxy).join("\n") +
    (report.available.length ? "\n" : ""), "utf8");
  return { report: rel(outputFile), available: rel(availableFile) };
}

async function commandProxyPool(argv) {
  const action = argv[0];
  const options = parseOptions(argv.slice(1));
  if (action === "up") {
    await proxyCompose(["up", "-d", "--build"]);
    return;
  }
  if (action === "down") {
    await proxyCompose(["down"]);
    return;
  }
  if (action === "status") {
    await proxyCompose(["ps"]);
    const { fetchAllProxyCandidates } = require("./../src/proxy/pool");
    try {
      const candidates = await fetchAllProxyCandidates();
      printJson({ ok: true, cn_candidates: candidates.length });
    } catch (error) {
      printJson({ ok: false, error: error.message, cn_candidates: 0 });
      process.exitCode = 1;
    }
    return;
  }

  if (action === "refresh-github") {
    const { GithubProxyRepositoryProvider } = require("./../src/proxy/providers/github_repository");
    const provider = new GithubProxyRepositoryProvider({
      filePath: options.path,
      ref: options.ref,
      repository: options.repository,
      timeoutMs: parsePositiveOption(options.timeoutMs, "--timeout-ms", 5000),
    });
    const proxies = await provider.listCandidates();
    printJson({ ok: true, ...provider.lastReport, candidate_count: proxies.length });
    return;
  }

  if (action === "diagnose") {
    const { classifyProxyError, cooldownMs, DEFAULT_STATE_FILE } = require("./../src/proxy/pool");
    const { ProxyBatchRuntime } = require("./../src/proxy/runtime");
    const runtime = new ProxyBatchRuntime({ classifyError: classifyProxyError, cooldownForError: cooldownMs, stateFile: DEFAULT_STATE_FILE });
    try {
      const report = await runtime.prepare({
        concurrency: parsePositiveOption(options.concurrency, "--concurrency", 16),
        limit: parsePositiveOption(options.samples, "--samples", 100),
        minAvailable: 0,
        minSuccessRate: 0,
        timeoutMs: parsePositiveOption(options.timeoutMs, "--timeout-ms", 3000),
      });
      report.target = "eastmoney-kline";
      report.passed = report.available_count > 0;
      report.report = await writeProxyBenchmarkReport(report, "diagnose");
      printJson(report);
    } finally {
      await runtime.close();
    }
    return;
  }

  if (action === "probe") {
    const { classifyProxyError, cooldownMs, DEFAULT_STATE_FILE } = require("./../src/proxy/pool");
    const { ProxyBatchRuntime } = require("./../src/proxy/runtime");
    const durationMs = parseDurationMs(options.duration ?? "10m");
    const intervalMs = parseDurationMs(options.interval ?? "30s");
    const samples = parsePositiveOption(options.samples, "--samples", 20);
    const concurrency = parsePositiveOption(options.concurrency, "--concurrency", 2);
    const timeoutMs = parsePositiveOption(options.hardDeadlineMs, "--hard-deadline-ms", 5000);
    const deadline = Date.now() + durationMs;
    const rounds = [];
    const runtime = new ProxyBatchRuntime({ classifyError: classifyProxyError, cooldownForError: cooldownMs, stateFile: DEFAULT_STATE_FILE });
    try {
      let startIndex = 0;
      do {
        const report = await runtime.prepare({ concurrency, limit: samples, minAvailable: 0, minSuccessRate: 0, startIndex, timeoutMs });
        rounds.push({ ...report, passed: report.available_count > 0, started_at: new Date().toISOString() });
        startIndex += samples;
        if (Date.now() < deadline) await new Promise((resolve) => setTimeout(resolve, Math.min(intervalMs, deadline - Date.now())));
      } while (Date.now() < deadline);
    } finally {
      await runtime.close();
    }
    const report = { duration_ms: durationMs, interval_ms: intervalMs, rounds, target: "eastmoney-kline" };
    report.report = await writeProxyBenchmarkReport(report, "probe");
    printJson(report);
    return;
  }

  if (action === "select") {
    const { DEFAULT_STATE_FILE } = require("./../src/proxy/pool");
    const { writeSelectedProxies } = require("./../src/proxy/selection");
    const minSuccessRate = Number(options.minSuccessRate ?? 0.8);
    if (!Number.isFinite(minSuccessRate) || minSuccessRate < 0 || minSuccessRate > 1) {
      throw new Error("--min-success-rate must be between 0 and 1.");
    }
    const outputFile = rootPath(options.output ?? "var/proxy-pool/selected.json");
    const report = await writeSelectedProxies({
      stateFile: DEFAULT_STATE_FILE,
      outputFile,
      minSamples: parsePositiveOption(options.minSamples, "--min-samples", 5),
      minSuccessRate,
      maxP95Ms: parsePositiveOption(options.maxP95Ms, "--max-p95-ms", 3000),
      limit: parsePositiveOption(options.limit, "--limit", 5),
    });
    report.output = rel(outputFile);
    printJson(report);
    return;
  }

  const { runProxyBenchmark, validateAllProxies } = require("./../src/proxy/pool");
  if (action === "verify") {
    const concurrency = parsePositiveOption(options.concurrency, "--concurrency", 8);
    const timeoutMs = parsePositiveOption(options.timeoutMs, "--timeout-ms", 6000);
    const limit = options.limit === undefined ? undefined : parsePositiveOption(options.limit, "--limit");
    const report = await validateAllProxies({ concurrency, timeoutMs, limit });
    report.files = await writeProxyVerificationReport(report, options.output);
    printJson(report);
    if (report.available_count === 0) {
      process.exitCode = 2;
    }
    return;
  }
  const samples = parsePositiveOption(options.samples, "--samples", action === "warmup" ? 20 : 100);
  const concurrency = parsePositiveOption(options.concurrency, "--concurrency", 4);
  if (action === "benchmark") {
    const report = await runProxyBenchmark({ samples, concurrency });
    report.report = await writeProxyBenchmarkReport(report, "benchmark");
    printJson(report);
    if (!report.passed) {
      process.exitCode = 2;
    }
    return;
  }
  if (action === "warmup") {
    const durationMs = parseDurationMs(options.duration ?? "30m");
    const deadline = Date.now() + durationMs;
    const rounds = [];
    do {
      rounds.push(await runProxyBenchmark({ samples, concurrency }));
      if (Date.now() < deadline) {
        await new Promise((resolve) => setTimeout(resolve, Math.min(60_000, deadline - Date.now())));
      }
    } while (Date.now() < deadline);
    const report = {
      started_at: rounds[0]?.started_at ?? new Date().toISOString(),
      finished_at: new Date().toISOString(),
      duration_ms: durationMs,
      rounds: rounds.map((round) => ({
        samples: round.samples,
        success: round.success,
        failed: round.failed,
        success_rate: round.success_rate,
        eligible_proxy_count: round.eligible_proxy_count,
        stable_proxy_count: round.stable_proxy_count,
        p95_duration_ms: round.p95_duration_ms,
        passed: round.passed,
        selector: round.selector,
        target: round.target,
      })),
      passed: rounds.some((round) => round.passed),
    };
    report.report = await writeProxyBenchmarkReport(report, "warmup");
    printJson(report);
    if (!report.passed) {
      process.exitCode = 2;
    }
    return;
  }

  throw new Error(`Unknown proxy pool command: ${action ?? ""}`);
}



function printDailyRunSummary(run, quality, failures) {
  const qualityStatus = quality?.status ?? "recorded";
  console.log(
    [
      `Daily run ${run.run_id}: ${run.status}`,
      `total=${run.total}`,
      `success=${run.success}`,
      `failed=${run.failed}`,
      `skipped=${run.skipped}`,
      `universe=${run.universe ?? "pool"}`,
      `universe_total_codes=${run.universe_total_codes ?? "n/a"}`,
      `batch_size=${run.batch_size ?? "n/a"}`,
      `selection_mode=${run.selection_mode ?? "n/a"}`,
      `job_mode=${run.job_mode ?? "single"}`,
      `job_status=${run.job_status ?? "n/a"}`,
      `progress_counts=${JSON.stringify(run.progress_counts ?? {})}`,
      `dispatch_next=${run.should_dispatch_next ?? false}`,
      `initial_failed=${run.initial_failed ?? 0}`,
      `retried=${run.retried ?? 0}`,
      `retry_success=${run.retry_success ?? 0}`,
      `retry_failed=${run.retry_failed ?? 0}`,
      `success_rate=${run.kline_success_rate ?? "n/a"}`,
      `engine_counts=${JSON.stringify(run.kline_engine_counts ?? {})}`,
      `router_region=${run.router_region_resolved ?? "n/a"}`,
      `router_probe=${run.router_probe_summary?.status ?? "n/a"}`,
      `failure_reason_counts=${JSON.stringify(run.kline_failure_reason_counts ?? {})}`,
      `region_counts=${JSON.stringify(run.kline_region_counts ?? {})}`,
      `quality=${qualityStatus}`,
    ].join(" ")
  );

  for (const item of failures.items.slice(0, 5)) {
    console.error(
      `Kline failure ${item.code ?? "unknown"}: ${item.reason ?? item.error ?? item.status ?? "unknown"}`
    );
  }

  if (quality?.status === "failed") {
    for (const issue of (quality.issues ?? []).slice(0, 5)) {
      console.error(`Quality issue ${issue.code ?? "unknown"}: ${issue.issue ?? "unknown"}`);
    }
  }
}



async function main() {
  const [command, subcommand, ...rest] = process.argv.slice(2);

  if (!command || command === "--help" || command === "-h") {
    printUsage();
    return;
  }

  if (command === "doctor") {
    await commandDoctor();
    return;
  }
  if (command === "simulator") {
    await commandSimulator([subcommand, ...rest].filter(Boolean));
    return;
  }
  if (command === "pool" && subcommand === "pull") {
    await commandPoolPull(rest);
    return;
  }
  if (command === "stocks") {
    await commandStocks([subcommand, ...rest]);
    return;
  }
  if (command === "codes" && subcommand === "build") {
    await commandCodesBuild(rest);
    return;
  }
  if (command === "kline" && subcommand === "sync") {
    await commandKlineSync(rest);
    return;
  }
  if (command === "kline" && subcommand === "aggregate-yearly") {
    await commandKlineAggregateYearly(rest);
    return;
  }
  if (command === "kline" && subcommand === "retry") {
    await commandKlineRetry(rest);
    return;
  }
  if (command === "kline" && subcommand === "retry-queue") {
    await commandKlineRetryQueue(rest);
    return;
  }
  if (command === "kline" && ["sync-status", "unlock"].includes(subcommand)) {
    await commandKlineSyncControl(subcommand, rest);
    return;
  }
  if (command === "kline" && subcommand === "fetch") {
    await commandKlineFetch(rest);
    return;
  }
  if (command === "kline" && subcommand === "validate") {
    await commandKlineValidate(rest);
    return;
  }
  if (command === "kline" && subcommand === "freshness") {
    await commandKlineFreshness(rest);
    return;
  }
  if (command === "daily") {
    await commandDaily([subcommand, ...rest].filter(Boolean));
    return;
  }
  if (command === "run") {
    await commandRun([subcommand, ...rest]);
    return;
  }
  if (command === "report") {
    await commandReport([subcommand, ...rest]);
    return;
  }
  if (command === "db") {
    await commandDb([subcommand, ...rest]);
    return;
  }
  if (command === "stats") {
    await commandStats([subcommand, ...rest]);
    return;
  }
  if (command === "aws") {
    await commandAws([subcommand, ...rest]);
    return;
  }
  if (command === "proxy") {
    await commandProxy([subcommand, ...rest]);
    return;
  }
  if (command === "benchmark") {
    await commandBenchmark([subcommand, ...rest]);
    return;
  }
  if (command === "git") {
    await commandGit([subcommand, ...rest]);
    return;
  }

  throw new Error(`Unknown command: ${command}`);
}

main().catch((error) => {
  console.error(error.message);
  process.exit(1);
});
