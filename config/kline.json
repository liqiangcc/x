{
  "aws_regions": [
    "ap-northeast-1",
    "ap-northeast-2",
    "ap-northeast-3",
    "ap-south-1",
    "ap-southeast-1",
    "ap-southeast-2",
    "ca-central-1",
    "eu-central-1",
    "eu-north-1",
    "eu-west-1",
    "eu-west-2",
    "eu-west-3",
    "sa-east-1",
    "us-east-1",
    "us-east-2",
    "us-west-1",
    "us-west-2"
  ],
  "lambda_name": "kline",
  "aws_router_url_env": "AWS_ROUTER_URL",
  "aws_router_token_env": "AWS_ROUTER_TOKEN",
  "huaweicloud_access_key_env": "HUAWEICLOUD_ACCESS_KEY",
  "huaweicloud_secret_key_env": "HUAWEICLOUD_SECRET_KEY",
  "policies": {
    "auto": { "engines": ["huaweicloud", "aws", "local"] },
    "proxy-first": { "engines": [{ "name": "proxy-pool", "selector": "balanced", "maxAttempts": 5, "timeoutMs": 6000 }, "huaweicloud", "aws", "local"] },
    "proxy-only": { "engines": [{ "name": "proxy-pool", "selector": "balanced", "maxAttempts": 1 }] },
    "cloud-first": { "engines": ["huaweicloud", "aws", { "name": "proxy-pool", "selector": "balanced", "maxAttempts": 3, "timeoutMs": 6000 }, "local"] }
  }
}
